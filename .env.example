# Defaults: simulated provider, SQLite at data/governance.sqlite, policy at config/governance.json
LLM_PROVIDER=local            # local | bedrock
# GOVERNANCE_DB=data/governance.sqlite
# GOVERNANCE_POLICY=config/governance.json
LOG_LEVEL=INFO

# AWS Bedrock (standard boto3 credential chain; prefer SSO profiles or IAM roles)
AWS_DEFAULT_REGION=us-west-2

# Optional: also export spans to an OTLP backend (requires requirements-cloud.txt)
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp.example.com
# OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer <token>
